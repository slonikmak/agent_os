{
  "name": "personal-desk-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/services/*.test.ts",
    "build": "tsc --noEmit && vite build --mode production",
    "build:dev": "tsc --noEmit && vite build --mode development",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@wailsio/runtime": "3.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
