              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "unsupported_operation"
              }
            }
          },
          "then": {
            "properties": {
              "message": {
                "const": "The operation is unsupported"
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "unauthorized"
              }
            }
          },
          "then": {
            "properties": {
              "message": {
                "const": "Authorization is required"
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "forbidden"
              }
            }
          },
          "then": {
            "properties": {
              "message": {
                "const": "This request is forbidden"
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "not_found"
              }
            }
          },
          "then": {
            "properties": {
              "message": {
                "const": "The resource was not found"
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "revision_conflict"
              }
            }
          },
          "then": {
            "properties": {
              "message": {
                "const": "The record changed; read its current state before retrying"
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "idempotency_conflict"
              }
            }
          },
          "then": {
            "properties": {
              "message": {
                "const": "The idempotency key was used for another request"
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "message_identity_conflict"
              }
            }
          },
          "then": {
            "properties": {
              "message": {
                "const": "The message identity was used for different content"
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "terminal_resolution"
              }
            }
          },
          "then": {
            "properties": {
              "message": {
                "const": "The message already has a terminal resolution"
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "payload_too_large"
              }
            }
          },
          "then": {
            "properties": {
              "message": {
                "const": "The request is too large"
