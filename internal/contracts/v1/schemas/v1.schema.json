          "then": {
            "required": [
              "errorId"
            ]
          },
          "else": {
            "not": {
              "required": [
                "errorId"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "revision_conflict"
              }
            }
