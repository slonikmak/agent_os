                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "unsupported_media_type"
              }
            }
          },
          "then": {
            "properties": {
              "message": {
                "const": "The media type is unsupported"
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
